APP_ENV=development
# Render: APP_ENV=production; use the start command documented in docs/deployment-readiness.md.
APP_HOST=127.0.0.1
APP_PORT=8000
CORS_ORIGINS=["http://localhost:5173"]
# Production: JSON array containing your exact HTTPS Vercel origin (no trailing slash).
# DATABASE_URL also accepts Render's postgresql:// URL; psycopg 3 is selected automatically.
DATABASE_URL=postgresql+psycopg://USERNAME:PASSWORD@localhost:5432/smart_building
TEST_DATABASE_URL=postgresql+psycopg://USERNAME:PASSWORD@localhost:5432/smart_building_test
JWT_SECRET=CHANGE_ME
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30
DEMO_STAFF_PASSWORD=CHANGE_ME
DEMO_ADMIN_PASSWORD=CHANGE_ME
DEMO_MAINTENANCE_ADMIN_PASSWORD=CHANGE_ME
ENERGY_TARIFF_PER_KWH=0.20
ENERGY_EMISSION_FACTOR_KG_PER_KWH=0.45
